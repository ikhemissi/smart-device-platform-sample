{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Device catalog of the Smart Device Platform. Requires a Microsoft Entra ID access token for the platform API; operations declare the app role they need in x-sdp-required-role.",
    "title" : "Smart Device Platform API",
    "version" : "v1"
  },
  "security" : [ {
    "entra" : [ ]
  } ],
  "paths" : {
    "/api/v1/alerts" : {
      "get" : {
        "description" : "Filter by status and site; alerts open at some point between from (default: 30 days ago) and to (default: now), most recent first.",
        "operationId" : "listAlerts",
        "parameters" : [ {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "pattern" : "(?i)open|closed|cancelled",
            "type" : "string",
            "enum" : [ "open", "closed", "cancelled" ]
          }
        }, {
          "in" : "query",
          "name" : "siteId",
          "required" : false,
          "schema" : {
            "maxLength" : 40,
            "minLength" : 1,
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "maximum" : 500,
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32",
            "default" : 100
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Alert"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Alerts of all devices",
        "tags" : [ "Alerting" ],
        "x-sdp-required-role" : "read"
      }
    },
    "/api/v1/anomalies" : {
      "get" : {
        "description" : "Anomalies overlapping the period between from (default: 7 days before to) and to (default: now), most recent first, filtered by site, device and status (default: confirmed and to_review, the anomalies to act on).",
        "operationId" : "listAnomalies",
        "parameters" : [ {
          "in" : "query",
          "name" : "siteId",
          "required" : false,
          "schema" : {
            "maxLength" : 40,
            "minLength" : 1,
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "deviceId",
          "required" : false,
          "schema" : {
            "maxLength" : 128,
            "minLength" : 1,
            "type" : "string"
          }
        }, {
          "description" : "Statuses to list, repeated or comma-separated: confirmed, to_review, dismissed, reviewed, pending.",
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "confirmed", "to_review", "dismissed", "reviewed", "pending" ]
            }
          }
        }, {
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "maximum" : 200,
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32",
            "default" : 100
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Anomaly"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Anomalies of the analysed sites",
        "tags" : [ "Anomalies" ],
        "x-sdp-required-role" : "read"
      }
    },
    "/api/v1/anomalies/{anomalyId}/review" : {
      "post" : {
        "description" : "Records whether the automated classification is correct, with an optional comment (at most 1,000 characters). The reviewer is the signed-in Editor; a new review replaces the previous one. The anomaly's status becomes reviewed.",
        "operationId" : "reviewAnomaly",
        "parameters" : [ {
          "in" : "path",
          "name" : "anomalyId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AnomalyReviewInput"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Anomaly"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Review an anomaly",
        "tags" : [ "Anomalies" ],
        "x-sdp-required-role" : "write"
      }
    },
    "/api/v1/devices" : {
      "get" : {
        "description" : "Filter by site and status, search id and display name (case-insensitive), sort and page.",
        "operationId" : "listDevices",
        "parameters" : [ {
          "in" : "query",
          "name" : "siteId",
          "required" : false,
          "schema" : {
            "maxLength" : 40,
            "minLength" : 1,
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "status",
          "required" : false,
          "schema" : {
            "pattern" : "reporting|silent",
            "type" : "string",
            "enum" : [ "reporting", "silent" ]
          }
        }, {
          "in" : "query",
          "name" : "search",
          "required" : false,
          "schema" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "sort",
          "required" : false,
          "schema" : {
            "pattern" : "displayName|siteId|firstSeen|lastSeen",
            "type" : "string",
            "enum" : [ "displayName", "siteId", "firstSeen", "lastSeen" ]
          }
        }, {
          "in" : "query",
          "name" : "order",
          "required" : false,
          "schema" : {
            "pattern" : "asc|desc",
            "type" : "string",
            "enum" : [ "asc", "desc" ]
          }
        }, {
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32",
            "default" : 1
          }
        }, {
          "in" : "query",
          "name" : "pageSize",
          "required" : false,
          "schema" : {
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer",
            "format" : "int32",
            "default" : 25
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DevicePage"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "List devices",
        "tags" : [ "Devices" ],
        "x-sdp-required-role" : "read"
      }
    },
    "/api/v1/devices/{deviceId}" : {
      "get" : {
        "description" : "The ETag header is required to edit it.",
        "operationId" : "getDevice",
        "parameters" : [ {
