<!-- Operation-level role check generated from the operation's x-sdp-required-role (${required_role}), routing
     to the operation's service when it is not the default backend (M4 design D6) and, for streamed answers (M6),
     a per-user message quota and unbuffered forwarding. -->
<policies>
  <inbound>
    <base />
%{ if backend_id != "" ~}
    <set-backend-service backend-id="${backend_id}" />
%{ endif ~}
%{ if required_role != "authenticated" ~}
    <choose>
      <when condition="@{
          var jwt = (Jwt)context.Variables["jwt"];
          var roles = jwt.Claims.ContainsKey("roles") ? jwt.Claims["roles"] : new string[0];
          return !(roles.Contains("DeviceData.Write")%{ if required_role == "read" } || roles.Contains("DeviceData.Read")%{ endif });
        }">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/problem+json</value>
          </set-header>
          <set-body>{"type":"about:blank","title":"Forbidden","status":403,"detail":"${detail}","requiredRole":"${app_role}"}</set-body>
        </return-response>
      </when>
    </choose>
%{ endif ~}
%{ if streaming ~}
    <rate-limit-by-key calls="${messages_per_min}" renewal-period="60" remaining-calls-header-name="X-RateLimit-Remaining"
                       counter-key="@("agent-" + ((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", context.Request.IpAddress))" />
%{ endif ~}
  </inbound>
  <backend>
%{ if streaming ~}
    <forward-request timeout="120" buffer-response="false" />
%{ else ~}
    <base />
%{ endif ~}
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
