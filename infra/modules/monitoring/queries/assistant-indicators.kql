// AI assistant indicators for the workbook's time range (one row per tile, platform-wide). Turns are the agent's
// sdp.agent.turn spans; tokens come from the Agent Framework's invoke_agent spans; rejected requests are agent API
// requests answered with 4xx/5xx (counted once per operation, whether API Management or the agent answered).
let turns = dependencies
    | where cloud_RoleName == 'sdp-device-analyst' and name == 'sdp.agent.turn'
    | extend FirstText = todouble(customDimensions['sdp.agent.first_text_ms']), Outcome = tostring(customDimensions['sdp.agent.outcome']),
             Tools = toint(customDimensions['sdp.agent.tool_calls']);
let tokens = dependencies
    | where cloud_RoleName == 'sdp-device-analyst' and name startswith 'invoke_agent'
    | summarize In = sum(toint(customDimensions['gen_ai.usage.input_tokens'])), Out = sum(toint(customDimensions['gen_ai.usage.output_tokens']));
let rejected = requests
    | where url has '/api/v1/agent/' and toint(resultCode) >= 400
    | summarize All = dcount(operation_Id), Limited = dcountif(operation_Id, resultCode == '429');
union
    (turns | summarize n = count(), users = dcount(user_Id)
        | project Order = 1, Indicator = 'Questions', Value = tostring(n), Detail = strcat(users, ' users')),
    (turns | summarize p50 = percentile(FirstText, 50), p95 = percentile(FirstText, 95)
        | project Order = 2, Indicator = 'Time to first text', Value = iff(isnotnull(p50), strcat(round(p50 / 1000, 1), ' s'), '–'),
                  Detail = iff(isnotnull(p95), strcat('median · p95 ', round(p95 / 1000, 1), ' s'), 'no answer')),
    (turns | summarize n = count(), fast = countif(FirstText <= 5000)
        | project Order = 3, Indicator = 'First text within 5 s', Value = iff(n > 0, strcat(round(100.0 * fast / n, 1), ' %'), '–'),
                  Detail = 'target ≥ 90 %'),
    (tokens
        | project Order = 4, Indicator = 'Tokens', Value = tostring(coalesce(In, 0) + coalesce(Out, 0)),
                  Detail = strcat(coalesce(In, 0), ' input · ', coalesce(Out, 0), ' output')),
    (turns | summarize calls = sum(Tools), n = count()
        | project Order = 5, Indicator = 'Tool calls', Value = tostring(coalesce(calls, 0)),
                  Detail = iff(n > 0, strcat(round(1.0 * calls / n, 1), ' per question'), 'platform data look-ups')),
    (turns | summarize failed = countif(Outcome == 'failed'), timeout = countif(Outcome == 'timeout')
        | project Order = 6, Indicator = 'Failed questions', Value = tostring(failed + timeout), Detail = strcat(timeout, ' timed out')),
    (rejected
        | project Order = 7, Indicator = 'Rejected requests', Value = tostring(All), Detail = strcat(Limited, ' rate-limited (429)'))
| order by Order asc
| project Indicator, Value, Detail
