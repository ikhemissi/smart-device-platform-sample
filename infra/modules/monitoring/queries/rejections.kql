// Device messages rejected by the decoder, per hour and reason (Site, DeviceType and DeviceId filters).
let messages = dependencies
    | where name == 'sdp.ingest.message'
    | extend PayloadFormat = tostring(customDimensions['sdp.payload.format'])
    | extend Site = tostring(customDimensions['sdp.site.id']), Device = tostring(customDimensions['sdp.device.id']),
             DeviceType = case(PayloadFormat == 'ruuvi-df5', 'Ruuvi (DF5)', PayloadFormat == 'ruuvi-df3', 'Ruuvi (DF3)', PayloadFormat == 'bthome-v2', 'BTHome v2',
                       PayloadFormat == 'cayenne-lpp', 'Cayenne LPP', PayloadFormat in ('', 'unknown'), 'Unknown (rejected)', PayloadFormat),
             Outcome = tostring(customDimensions['sdp.ingestion.outcome']), Reason = tostring(customDimensions['sdp.rejection.reason'])
    | where ('*' in ({Site}) or Site in ({Site})) and ('*' in ({DeviceType}) or DeviceType in ({DeviceType})) and ('*' in ({DeviceId}) or Device in ({DeviceId}));
messages
| where Outcome == 'rejected'
| summarize Rejected = count() by bin(timestamp, 1h), Reason
| order by timestamp asc
