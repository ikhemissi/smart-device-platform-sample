// Device messages rejected by the decoder, per hour and reason.
customMetrics
| where name == 'sdp.ingestion.messages' and tostring(customDimensions['sdp.ingestion.outcome']) == 'rejected'
| summarize Rejected = sum(valueSum) by bin(timestamp, 1h), Reason = tostring(customDimensions['sdp.rejection.reason'])
| order by timestamp asc
